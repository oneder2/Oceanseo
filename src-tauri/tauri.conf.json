{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tideplan",
  "version": "1.0.0",
  "identifier": "com.tideplan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oceanseo",
        "width": 1240,
        "height": 790,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "oceanseo"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "Productivity",
    "shortDescription": "模块化个人管理与共享工作区",
    "longDescription": "Oceanseo 开源个人版：可自由组合工具的工作区、本地待办、生活计划与拼豆创作。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": null
      }
    }
  }
}
