{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tideplan",
  "version": "0.9.2",
  "identifier": "com.tideplan.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "潮汐计划",
        "width": 1240,
        "height": 790,
        "minWidth": 620,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["oceanseo"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Productivity",
    "shortDescription": "短期、中期与长期计划桌面助手",
    "longDescription": "为 Linux Mint、Ubuntu 和 Debian 设计的本地桌面计划助手。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": null
      }
    }
  }
}
