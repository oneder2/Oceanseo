[Unit]
Description=Audit Tideplan private sync database backup
After=tideplan-sync-backup.service

[Service]
Type=oneshot
User=tideplan-sync
Group=tideplan-sync
ExecStart=/usr/bin/python3 /opt/tideplan-sync/backup-audit.py --label sync --database /var/lib/tideplan-sync/vault.sqlite3 --backup-dir /var/backups/tideplan-sync --required-table vault --max-age-hours 30 --status-file /var/lib/tideplan-sync/backup-audit-status.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tideplan-sync
UMask=0077
