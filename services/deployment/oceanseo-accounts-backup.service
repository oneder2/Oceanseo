[Unit]
Description=Oceanseo private account database online backup
After=oceanseo-accounts.service
Requires=oceanseo-accounts.service

[Service]
Type=oneshot
User=oceanseo-accounts
Group=oceanseo-accounts
ExecStart=/opt/oceanseo-accounts/services/deployment/accounts-backup-daily.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oceanseo-accounts /var/backups/oceanseo-accounts
