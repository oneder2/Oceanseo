[Unit]
Description=Audit Oceanseo private account database backup
After=oceanseo-accounts-backup.service

[Service]
Type=oneshot
User=oceanseo-accounts
Group=oceanseo-accounts
ExecStart=/usr/bin/python3 /opt/oceanseo-accounts/services/deployment/backup-audit.py --label accounts --database /var/lib/oceanseo-accounts/accounts.sqlite3 --backup-dir /var/backups/oceanseo-accounts --required-table users --required-table vaults --max-age-hours 30 --status-file /var/lib/oceanseo-accounts/backup-audit-status.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/oceanseo-accounts
UMask=0077
