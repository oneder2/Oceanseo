{
  "name": "tideplan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-beads.mjs",
    "test:ui-quality": "node scripts/ui-quality-runner.mjs",
    "test:bundle": "node scripts/bundle-budget.mjs",
    "test:calendar-performance": "node scripts/calendar-performance.mjs",
    "test:diagnostic-contract": "node scripts/diagnostic-contract.mjs",
    "test:release-contract": "node scripts/release-contract.mjs",
    "test:sync-server": "cd services/sync && python3 -m unittest -v test_server",
    "test:accounts-server": "python3 -m unittest -v services.accounts.test_server services.accounts.test_deployment services.accounts.test_control",
    "test:backup-audit": "python3 -m unittest -v services.deployment.test_backup_audit",
    "test:backup-alert": "python3 -m unittest -v services.deployment.test_backup_alert",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "landing:dev": "vite --config landing/vite.config.ts",
    "landing:build": "tsc -p landing/tsconfig.json && node scripts/build-landing.mjs",
    "control:dev": "vite --config control-admin/vite.config.ts",
    "control:build": "tsc -p control-admin/tsconfig.json && vite build --config control-admin/vite.config.ts",
    "tauri": "tauri",
    "android:doctor": "node scripts/android-doctor.mjs",
    "android:build": "tauri android build --debug --target aarch64 --apk --ci",
    "android:release": "node scripts/android-release.mjs",
    "cleanup": "node scripts/build-cleanup.mjs --apply --enforce-budget --if-idle",
    "release:linux": "tauri build --config src-tauri/tauri.personal-workspaces.conf.json --bundles deb",
    "test:release-linux": "node scripts/linux-release-contract.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "gsap": "3.15.0",
    "leaflet": "^1.9.4",
    "lenis": "1.3.26",
    "lucide-react": "^0.542.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "qrcode": "1.5.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "license": "MIT"
}
